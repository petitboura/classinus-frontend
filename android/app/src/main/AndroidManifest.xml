<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".ClovisApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 23/09/2026 : retour de la connexion Google dans l'appli
                 (voir lib/connexionGoogleNative.ts). Reçu directement par
                 MainActivity, distinct du retour des connecteurs Notion et
                 Drive (classinusmobile://oauth-callback, plus bas). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="classinusmobile" android:host="connexion" />
            </intent-filter>

            <!-- 21/10/2026 : liens de Classinus qui ouvrent l'appli (App Links).
                 Un lien https://classinus.com/... touche dans un email, un
                 message ou une page s'ouvre ici au lieu du navigateur, une fois
                 la verification faite par Android (fichier
                 public/.well-known/assetlinks.json du site). Voir
                 lib/liensEntrants.ts, qui recoit le lien (appUrlOpen).
                 L'hote vient de manifestPlaceholders (build.gradle).
                 Une ligne par page de premier niveau, SANS /oauth,
                 /agent-superposition ni /dev-demo-question (voir
                 PREFIXES_NON_OUVERTS_DANS_APPLI) : Android ne sait pas exclure,
                 il faut donc lister. tests/verifier-liens-entrants.mjs verifie
                 que cette liste suit les pages de app/. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${hoteLiensApp}" />
                <data android:path="/" />
                <data android:pathPrefix="/admin" />
                <data android:pathPrefix="/bibliotheque" />
                <data android:pathPrefix="/bureau" />
                <data android:pathPrefix="/cgu" />
                <data android:pathPrefix="/comportements" />
                <data android:pathPrefix="/confidentialite" />
                <data android:pathPrefix="/connecter-claude" />
                <data android:pathPrefix="/connecter-thonny" />
                <data android:pathPrefix="/connexion" />
                <data android:pathPrefix="/controle-session" />
                <data android:pathPrefix="/copyright" />
                <data android:pathPrefix="/decouvrir" />
                <data android:pathPrefix="/dossiers" />
                <data android:pathPrefix="/etablissements" />
                <data android:pathPrefix="/inscription" />
                <data android:pathPrefix="/memoire" />
                <data android:pathPrefix="/mon-espace" />
                <data android:pathPrefix="/mot-de-passe-oublie" />
                <data android:pathPrefix="/parametres" />
                <data android:pathPrefix="/personnaliser" />
                <data android:pathPrefix="/plus" />
                <data android:pathPrefix="/rappels" />
                <data android:pathPrefix="/reinitialiser-mot-de-passe" />
                <data android:pathPrefix="/signalements" />
                <data android:pathPrefix="/skills" />
                <data android:pathPrefix="/skills-publics" />
                <data android:pathPrefix="/tableau-de-bord" />
                <data android:pathPrefix="/telecharger" />
            </intent-filter>

        </activity>

        <activity
            android:name=".notifications.AlerteRappelActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- Lot 5 (porte 25/08/2026) : recoit la redirection OAuth (Notion,
             puis autres connecteurs) sur classinusmobile://oauth-callback, ouvert
             via Custom Tabs depuis ConnecteursPlugin.kt. singleTask pour ne
             pas empiler une nouvelle instance par-dessus MainActivity. -->
        <activity
            android:name=".connecteurs.OAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="classinusmobile" android:host="oauth-callback" />
            </intent-filter>
        </activity>

        <!-- 26/08/2026 (Bourama, rappels programmes) : recoit l'alarme
             AlarmManager declenchee par NotificationsPlugin.programmerRappel,
             affiche la notification au moment voulu meme app fermee. -->
        <receiver
            android:name=".notifications.RappelAlarmReceiver"
            android:exported="false" />

        <!-- 09/09/2026 (Bourama, session de concentration basee sur une
             duree) : recoit l'alarme AlarmManager declenchee par
             ControleSessionPlugin.demarrerSession, restaure l'etat du
             telephone a la fin de la duree meme app fermee, meme forme
             que RappelAlarmReceiver ci-dessus. -->
        <receiver
            android:name=".controlesession.ControleSessionAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".notifications.ClovisFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lot 4 (porte 25/08/2026) : DND + volume sonnerie/notifications pendant
         une session : permission speciale, pas de popup standard, redirection
         vers Reglages geree par ControleSessionRepository.kt. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- 26/08/2026 (Bourama, temps d'ecran) : requise pour que l'app
         apparaisse dans Reglages > Acces special > Acces a l'usage, sinon
         l'etudiant n'a nulle part ou accorder la permission verifiee par
         TempsEcranPlugin.kt (AppOpsManager.OPSTR_GET_USAGE_STATS). Ne
         declenche pas de popup standard, juste la visibilite dans ce menu
         Reglages. Voir tools:ignore, requis par le lint Android pour
         les permissions protegees. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 02/10/2026 (Bourama, voix en direct) : acces au micro pour parler a Classinus
         (Gemini Live, lib/geminiLive.ts). Capacitor affiche lui meme la demande
         d'autorisation de l'etudiant la premiere fois. MODIFY_AUDIO_SETTINGS permet
         d'utiliser le micro et le haut parleur ensemble. Le micro reste facultatif
         pour ne pas exclure les appareils sans micro. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
